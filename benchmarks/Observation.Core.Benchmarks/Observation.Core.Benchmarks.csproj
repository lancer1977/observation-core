<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet's transitive graph resolves some older ranges upward (NU1603); tolerated for this non-shipping project only. -->
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.6" />
    <ProjectReference Include="../../src/Observation.Core/Observation.Core.csproj" />
  </ItemGroup>
</Project>
